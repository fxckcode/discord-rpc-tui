[Unit]
Description=Discord Rich Presence TUI — custom activity manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/fxckcode/.hermes/node/bin/node /home/fxckcode/projects/discord-rpc-tui/dist/index.js
WorkingDirectory=/home/fxckcode/projects/discord-rpc-tui
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
Environment=XDG_RUNTIME_DIR=/run/user/1000

[Install]
WantedBy=default.target
