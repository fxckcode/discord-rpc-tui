{
  "name": "discord-rpc-tui",
  "version": "0.4.0",
  "description": "MCP server, TUI, and web gallery — forge Discord Rich Presence with elegance and AI",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "rpc-tui": "dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.tsx --out-dir dist --format esm --clean",
    "build:web": "cd web && pnpm build",
    "dev": "tsup src/index.tsx --out-dir dist --format esm --watch",
    "dev:web": "cd web && pnpm dev",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:web": "cd web && pnpm test",
    "version": "node -p \"require('./package.json').version\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xhayper/discord-rpc": "^1",
    "conf": "^13",
    "express": "^5.2.1",
    "ink": "^7",
    "react": "^19",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/react": "^19",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^3"
  },
  "keywords": [
    "discord",
    "rich-presence",
    "rpc",
    "tui",
    "ink",
    "presence-gallery"
  ],
  "author": "fxckcode",
  "license": "MIT"
}
